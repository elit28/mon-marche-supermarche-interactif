# ---------------------------------------------------------------------------
# MON MARCHÉ — variables d'environnement
# Copiez ce fichier vers `.env` (jamais committé) et adaptez les valeurs.
# ---------------------------------------------------------------------------

# Connexion PostgreSQL (16+). Les extensions pg_trgm et unaccent sont créées
# automatiquement par `pnpm db:migrate` (droits suffisants requis).
DATABASE_URL=postgres://monmarche:monmarche@localhost:5432/monmarche
DATABASE_POOL_SIZE=10

# Secret utilisé pour signer les cookies (identifiant invité, session admin).
# Générez-le avec : openssl rand -base64 48
SESSION_SECRET=remplacez-moi-par-une-valeur-aleatoire-de-48-caracteres-minimum

# URL publique du site (liens de partage, métadonnées).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# User-Agent envoyé aux API Open Food Facts (obligatoire selon leur
# documentation). Ajoutez idéalement un moyen de contact : "MonMarche/0.1 (contact@exemple.fr)".
OFF_USER_AGENT=MonMarche/0.1 (supermarche-virtuel-open-source; demo)

# Autorise le déclenchement d'un rafraîchissement du catalogue depuis l'administration.
ADMIN_IMPORT_ENABLED=true
